# ============================================================
# أثر | ATHAR Brands — Environment Variables (reference)
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local. NEVER expose the service role key
# to the browser. Only NEXT_PUBLIC_* values reach the client.
# ============================================================

# Public site URL — used for SEO canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://atharbrands.com

# Supabase project URL  (Supabase Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anon/public key (Project Settings → API → Project API keys → anon public)
# Not used by the browser in this project; kept for completeness / future use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY. Used by API routes to insert leads.
# Never expose to the client. Never print to logs. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp number in international format, digits only (no "+", no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000
